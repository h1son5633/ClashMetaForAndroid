<?xml version="1.0" encoding="utf-8"?>
<!-- v9.1 home-screen widget: white card mirroring the iOS Clash widget.
     Changes vs v9: (1) the power control is a separate ROUND button again,
     styled like the top-right "fastest node" button (user reversed the v9
     merged end-cap design after seeing it rendered); (2) the mode bar has a
     fixed height and its segment labels are match_parent + singleLine —
     the v9 wrap_content + vertical-padding labels rendered clipped in half
     on the user's launcher.
     RemoteViews-safe views only (LinearLayout / TextView / ImageView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF111111"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/widget_refresh"
            android:padding="4dp"
            android:src="@drawable/ic_baseline_sync" />

        <ImageView
            android:id="@+id/widget_fastest"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_bg_fastest_btn"
            android:contentDescription="@string/widget_fastest"
            android:padding="6dp"
            android:src="@drawable/widget_ic_fastest" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FF8A8A8E"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_rates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FF3A3A3C"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_totals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FF8A8A8E"
        android:textSize="11sp" />

    <!-- Bottom row: mode segment bar (fixed height, labels fill it) plus the
         round power button as its own element on the right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bg_segment_track"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/widget_mode_rule"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/widget_mode_rule"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_mode_global"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/widget_mode_global"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_mode_direct"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/widget_mode_direct"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_power"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_bg_power_off"
            android:contentDescription="@string/widget_toggle"
            android:padding="11dp"
            android:src="@drawable/ic_home_power" />
    </LinearLayout>
</LinearLayout>
