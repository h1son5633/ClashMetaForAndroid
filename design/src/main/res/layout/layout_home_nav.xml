<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data />

    <!-- VideoX-style floating bottom navigation: no shared board, each
         tab is its own capsule button (52dp tall — the same height as the
         home menu rows — icon + label side
         by side, 10dp gaps). No glass, no press/ripple effect — tapping
         only fires haptic feedback. The current page's capsule is the
         accent-tinted one; backgrounds are swapped in HomeNavStyle and
         icon/label colours are set per page in the *Design classes. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/home_nav_btn_normal"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home_house" />

            <TextView
                android:id="@+id/navHomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/home_nav_home"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/home_nav_btn_normal"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/navStatsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home_stats" />

            <TextView
                android:id="@+id/navStatsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/home_nav_stats"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/home_nav_btn_normal"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/navHubIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_baseline_apps" />

            <TextView
                android:id="@+id/navHubText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/home_nav_hub"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/home_nav_btn_normal"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_baseline_settings" />

            <TextView
                android:id="@+id/navSettingsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/home_nav_settings"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</layout>
